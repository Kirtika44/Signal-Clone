# ==============================================================================
# Signal Clone - Master Environment Variables Example (.env.example)
# ==============================================================================
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL.
# Copy this file to .env or set these variables in your hosting provider's dashboard.

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel / Next.js)
# ------------------------------------------------------------------------------
# Target URL where your deployed FastAPI backend is running (HTTP / HTTPS).
# In production, set to your backend URL e.g.: https://signal-clone-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket Base URL (ws:// or wss://).
# If omitted, it will automatically be derived from NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Render / Railway / Fly.io / Docker)
# ------------------------------------------------------------------------------
# Secret key used for signing JWT authentication tokens.
# Generate a cryptographically random 32+ character string for production.
JWT_SECRET_KEY=signal_clone_super_secure_jwt_secret_key_2026_x89

# Database Connection URL.
# SQLite (Local / Persistent Volume): sqlite:///./signal.db
# PostgreSQL (Cloud / Supabase / Railway): postgresql://username:password@host:5432/dbname
DATABASE_URL=sqlite:///./signal.db

# CORS Allowed Origins.
# Comma-separated list of allowed origins, or * for open access.
# Example: http://localhost:3000,https://your-signal-clone.vercel.app
ALLOWED_ORIGINS=*

# Port for FastAPI server (Render/Railway sets $PORT dynamically)
PORT=8000
