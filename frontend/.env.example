# ==========================================================
# Signal Clone Frontend Environment Variables (Example)
# ==========================================================

# Base URL of the backend API (HTTP / HTTPS)
# Local Development: Leave empty or use http://localhost:8000
# Production (Vercel): Set to your deployed backend URL (e.g. https://signal-api.onrender.com)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Base URL for WebSockets (ws:// or wss://)
# If omitted, this will be automatically derived from NEXT_PUBLIC_API_URL
NEXT_PUBLIC_WS_URL=ws://localhost:8000
