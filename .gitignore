# ==========================================================
# Signal Clone - Root .gitignore
# ==========================================================

# Node & Frontend Dependencies
node_modules/
frontend/node_modules/
.pnp
.pnp.js

# Next.js Build Output
.next/
frontend/.next/
out/
frontend/out/
build/
dist/

# Python Bytecode & Environments
__pycache__/
backend/app/**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
backend/venv/
backend/.venv/
ENV/

# Environment Variables & Secrets
.env
.env*.local
.env.development
.env.production
*.env
frontend/.env
frontend/.env.local
backend/.env

# SQLite Databases
*.db
*.sqlite
*.sqlite3
backend/signal.db
backend/*.db

# Uploads & Media (Preserve folder structure)
backend/uploads/*
!backend/uploads/.gitkeep

# Logs & Debug Output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Testing & Coverage
.coverage
htmlcov/
.pytest_cache/

# OS & IDE Metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
*.tsbuildinfo
